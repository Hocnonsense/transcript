"""A Python document recording text, a CSV table, a base64 PNG, and a Datavzrd table."""

import base64
import json
import struct
import zlib
from pathlib import Path

import pandas as pd


def png_data_uri(red: int):
    """Encode a deterministic one-pixel RGB PNG using only the stdlib."""

    def chunk(kind: bytes, payload: bytes):
        body = kind + payload
        return (
            struct.pack(">I", len(payload)) + body + struct.pack(">I", zlib.crc32(body))
        )

    png = (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(bytes([0, red, 64, 128])))
        + chunk(b"IEND", b"")
    )
    return "data:image/png;base64," + base64.b64encode(png).decode("ascii")


data = json.loads(Path(__file__).with_name("data.json").read_text(encoding="utf-8"))
message = f"Sample: {data['label']}"

"""
The following records archive a string, a table, and an inline image.
>>> message
'Sample: baseline'
"""

image_source = {"red": data["red"], "green": 64, "blue": 128}
picture = f"![]({png_data_uri(image_source['red'])})"

"""
## Image

This tiny image is encoded directly from its RGB source data.

>>> image_source
{'red': 32, 'green': 64, 'blue': 128}
>>> print(picture)
![](data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGNQcGgAAAFkAOHHE8n2AAAAAElFTkSuQmCC)
"""

table = pd.DataFrame([data], columns=["label", "value"])

"""
## Interactive table

The measurements are archived a second time as a Datavzrd snapshot.
Opening the exported HTML turns this table into a sortable, filterable report.

>>> from snakedone import datavzrd
>>> datavzrd(table)
```snakedone-output
{
  "config": {
    "default-view": "results",
    "views": {
      "results": {
        "dataset": "data"
      }
    }
  },
  "datasets": {
    "data": {
      "content": "label,value\\nbaseline,7\\n",
      "format": "csv"
    }
  },
  "renderer": "datavzrd",
  "version": 1
}
```
"""

